{
  "manifest_version": 3,
  "name": "GitHub 加速下载",
  "version": "1.2.5",
  "description": "为 GitHub 源码压缩包与 Release 资产链接提供右键「GitHub 加速下载」，通过可自定义的加速前缀转换后直接触发浏览器下载。",
  "minimum_chrome_version": "96",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub 加速下载设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.github.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}